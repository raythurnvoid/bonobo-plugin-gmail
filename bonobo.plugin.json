{
	"schemaVersion": 1,
	"name": "gmail",
	"displayName": "Gmail",
	"version": "0.3.9",
	"description": "Save sent and received Gmail emails and attachments in Press Files. Read them in Mail, and write Gmail drafts with the chat agent.",
	"compatibility": { "bonoboPluginRuntime": "1" },
	"events": [],
	"pages": [
		{ "id": "gmail", "title": "Gmail", "entry": "dist/frontend/index.html", "navItem": { "label": "Gmail" } },
		{
			"id": "mail",
			"title": "Mail",
			"entry": "dist/frontend/index.html",
			"navItem": {
				"label": "Mail",
				"icon": "mail"
			},
			"agent": {
				"tools": [
					{
						"name": "get_view",
						"description": "Show what the member sees in Mail right now: the account, the mailbox folder, the open email or draft, and the newest emails in the list.",
						"inputSchema": {
							"type": "object",
							"properties": {},
							"additionalProperties": false
						}
					},
					{
						"name": "open_email",
						"description": "Open one email in the Mail page and return its headers and text. Use a path from get_view or from the Files tools, for example /emails/me-example-com/2026/10/18-hello-18f2a.md.",
						"inputSchema": {
							"type": "object",
							"properties": {
								"path": {
									"type": "string",
									"description": "The email's Files path."
								}
							},
							"required": [
								"path"
							],
							"additionalProperties": false
						}
					},
					{
						"name": "list_drafts",
						"description": "List the member's Gmail drafts made in Press, newest first. Bodies are not listed. To read one, ask the member to open it in the Mail page, then call get_view.",
						"inputSchema": {
							"type": "object",
							"properties": {},
							"additionalProperties": false
						}
					},
					{
						"name": "create_draft",
						"description": "Write a new Gmail draft and open it in the Mail page so the member can review it. Saved as a Gmail draft. It is not sent; only the member can send it. To reply, pass the email's path as replyToPath.",
						"inputSchema": {
							"type": "object",
							"properties": {
								"to": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"description": "Recipient addresses."
								},
								"cc": {
									"type": "array",
									"items": {
										"type": "string"
									}
								},
								"subject": {
									"type": "string"
								},
								"body": {
									"type": "string",
									"description": "Plain text body."
								},
								"replyToPath": {
									"type": "string",
									"description": "Files path of the email this draft answers."
								}
							},
							"required": [
								"to",
								"subject",
								"body"
							],
							"additionalProperties": false
						}
					},
					{
						"name": "update_draft",
						"description": "Change a Gmail draft and open it in the Mail page. Fields you leave out stay the same. Saved as a Gmail draft. It is not sent; only the member can send it. Refused while the member is typing in the draft.",
						"inputSchema": {
							"type": "object",
							"properties": {
								"draftId": {
									"type": "string",
									"description": "A draftId from list_drafts or create_draft."
								},
								"to": {
									"type": "array",
									"items": {
										"type": "string"
									}
								},
								"cc": {
									"type": "array",
									"items": {
										"type": "string"
									}
								},
								"subject": {
									"type": "string"
								},
								"body": {
									"type": "string"
								}
							},
							"required": [
								"draftId"
							],
							"additionalProperties": false
						}
					},
					{
						"name": "delete_draft",
						"description": "Delete a Gmail draft that you changed last. Gmail deletes it for good. A draft the member changed last is refused; ask the member to delete it. Refused while the member is typing in the draft.",
						"inputSchema": {
							"type": "object",
							"properties": {
								"draftId": {
									"type": "string",
									"description": "A draftId from list_drafts or create_draft."
								}
							},
							"required": [
								"draftId"
							],
							"additionalProperties": false
						}
					}
				]
			}
		}
	],
	"capabilities": ["plugin.service.connect", "ui.outbound.fetch", "workspace.files.read", "workspace.files.write", "agent.page-tools"],
	"outboundOrigins": [],
	"uiOutboundOrigins": ["https://kindhearted-mallard-511.convex.site"],
	"files": [
		{ "path": "dist/frontend/index.html", "sha256": "sha256:0f1543e7d0ad370fe64039ff2d49ff01174d9239e7257de765e0eb775aa3a96a", "bytes": 437, "contentType": "text/html" },
		{ "path": "dist/frontend/assets/index.js", "sha256": "sha256:c7ae00073a3172ec28eeb4c41557c6f2ebf3cc11d3bab849454047b4f21b4b5c", "bytes": 111076, "contentType": "application/javascript" },
		{ "path": "dist/frontend/assets/gmail-page.css", "sha256": "sha256:0080682c7f1a01d174fa68c5c7d93a9480e6f8ca30a9e0b9ec1aa7b5947c5de5", "bytes": 1517, "contentType": "text/css" },
		{ "path": "dist/frontend/assets/mail-app.css", "sha256": "sha256:0d403d64918dbf4b458cf83f68a0efccfb014caf671fda59d6de800e26205a22", "bytes": 6310, "contentType": "text/css" },
		{ "path": "dist/frontend/assets/gmail-api.js", "sha256": "sha256:7b1215130d2d4e05fb8671f5fe682baa17f40f45dd45f51b05e0f8737d2e19e3", "bytes": 5946, "contentType": "application/javascript" },
		{ "path": "dist/frontend/assets/gmail-page.js", "sha256": "sha256:d2251eed6191443dd3f0ee3629d360e23e0d1d250271028d6dd854e5c88952a3", "bytes": 28798, "contentType": "application/javascript" },
		{ "path": "dist/frontend/assets/mail-app.js", "sha256": "sha256:8671883133d9926f5f2ad20c11a445bb1b6e5813c1bebd357c2602e923ca98d7", "bytes": 44166, "contentType": "application/javascript" },
		{ "path": "dist/frontend/assets/react.js", "sha256": "sha256:8a04d33413e1af23d3da12f720c870e7841a63671a5657a60c063c5b522ae79f", "bytes": 421948, "contentType": "application/javascript" },
		{ "path": "dist/frontend/assets/zod.js", "sha256": "sha256:75f6638f0fc7e668b6016702c3993585846020ae9da2100ce7dccb255da9ebd8", "bytes": 126770, "contentType": "application/javascript" },
		{ "path": "dist/frontend/assets/rolldown-runtime.js", "sha256": "sha256:5388ca8b7a40c7dc758236649b52600b193fa7b2cfaac61c9030bdf3ac2523df", "bytes": 926, "contentType": "application/javascript" }
	]
}
